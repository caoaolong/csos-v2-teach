# edk2 整体忽略，仅保留自研引导包与 HelloWorld 示例
edk2/*
!edk2/CsosBootPkg/
!edk2/CsosBootPkg/**
!edk2/MdeModulePkg/
edk2/MdeModulePkg/*
!edk2/MdeModulePkg/Application/
edk2/MdeModulePkg/Application/*
!edk2/MdeModulePkg/Application/HelloWorld/
!edk2/MdeModulePkg/Application/HelloWorld/**

/debug.log
/build
/examples/**/build
/.opencode
# QEMU 磁盘镜像：本地生成的大文件，不进仓库（GitHub 100MB 限制）
/qemu/*.img
/qemu/*.vhd
/qemu/*.vdi
/qemu/vbox/
# ELF 二进制：构建产物，本地保留用于 QEMU 启动/gdb，不进仓库与历史
*.elf