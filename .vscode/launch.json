{
  // 使用 IntelliSense 了解相关属性。
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UEFI Emulator (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/edk2/Build/EmulatorX64/DEBUG_VS2026/X64/WinHost.exe",
      "args": [],
      "cwd": "${workspaceFolder}/edk2/Build/EmulatorX64/DEBUG_VS2026/X64/",
      "symbolSearchPath": "${workspaceFolder}/edk2/Build"
    },
    {
      "name": "QEMU Kernel (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/kernel.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "D:/cygwin64/bin/gdb.exe",
      "targetArchitecture": "x64",
      "sourceFileMap": {
        "/cygdrive/d/project/csos-v2-teach": "D:/project/csos-v2-teach"
      },
      "customLaunchSetupCommands": [
        {
          "text": "source /cygdrive/d/project/csos-v2-teach/.vscode/gdbinit"
        }
      ],
      "launchCompleteCommand": "exec-continue"
    },
    {
      "name": "Example: Long Mode",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/examples/long-mode/build/kernel.elf",
      "cwd": "${workspaceFolder}/examples/long-mode",
      "MIMode": "gdb",
      "miDebuggerPath": "D:/cygwin64/bin/gdb.exe",
      "targetArchitecture": "x86",
      "sourceFileMap": {
        "/cygdrive/d/project/csos-v2-teach": "D:/project/csos-v2-teach"
      },
      "customLaunchSetupCommands": [
        {
          "text": "source /cygdrive/d/project/csos-v2/.vscode/gdbinit"
        }
      ],
      "launchCompleteCommand": "exec-continue"
    }
  ]
}
